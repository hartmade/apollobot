# Absolute host path. It is intentionally mounted at the same absolute path
# inside the service so sibling sandbox containers can bind research files.
APOLLOBOT_DATA_DIR=/srv/frontier-science/apollobot
APOLLOBOT_UID=10001
APOLLOBOT_GID=10001
DOCKER_GID=999
APOLLOBOT_DOCKER_SOCKET=/var/run/docker.sock
APOLLOBOT_BIND_ADDRESS=127.0.0.1
APOLLOBOT_PORT=8765
APOLLOBOT_RELEASE_SHA=replace-with-the-release-git-commit-sha
APOLLOBOT_SERVICE_IMAGE=frontier-science/apollobot-service:replace-with-the-release-git-commit-sha

# Generate independent values with: openssl rand -hex 32
APOLLOBOT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
APOLLOBOT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
FRONTIER_PLATFORM_URL=https://platform.example.org
APOLLOBOT_ALLOWED_ORIGIN=
APOLLOBOT_CONTACT_EMAIL=

# Optional. Leave empty to use ApolloBot's direct scientific API adapters.
# Set only after deploying an HTTPS MCP adapter service.
APOLLOBOT_MCP_PROXY_URL=

# anthropic, openai, or minimax. OpenAI-compatible services can use the
# openai provider together with OPENAI_BASE_URL and OPENAI_MODEL.
APOLLOBOT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# For deterministic OpenRouter billing, pin one endpoint and copy its live
# per-million-token prices from the OpenRouter endpoints API.
OPENROUTER_PROVIDER_TAG=
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_SITE_URL=https://frontier-science.ai
OPENROUTER_APP_NAME=Frontier Science
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_REASONING_EXCLUDE=1
APOLLOBOT_MODEL_BILLING_PROVIDER=
APOLLOBOT_MODEL_INPUT_COST_PER_M=
APOLLOBOT_MODEL_CACHED_INPUT_COST_PER_M=
APOLLOBOT_MODEL_OUTPUT_COST_PER_M=
APOLLOBOT_MODEL_MAX_OUTPUT_TOKENS=4096
MINIMAX_API_KEY=

APOLLOBOT_SANDBOX_IMAGE=frontier-science/apollobot-sandbox:replace-with-the-release-git-commit-sha
APOLLOBOT_SANDBOX_MEMORY_MB=2048
APOLLOBOT_SANDBOX_CPUS=2
APOLLOBOT_SANDBOX_PIDS=256
APOLLOBOT_SANDBOX_OUTPUT_BYTES=2000000
APOLLOBOT_MAX_CONCURRENT_JOBS=3
APOLLOBOT_MAX_CONCURRENT_PLANS=3
APOLLOBOT_PLANNER_TIMEOUT=40
APOLLOBOT_MAX_LITERATURE_QUERIES=2
APOLLOBOT_MAX_DATA_REQUIREMENTS=2
APOLLOBOT_MAX_ANALYSIS_STEPS=2
