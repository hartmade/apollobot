FROM ghcr.io/astral-sh/uv:0.8.22 AS uv

FROM python:3.12-slim-bookworm

ARG APOLLOBOT_RELEASE_SHA=9a49281c0dae

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}" \
    HOME=/home/apollobot \
    APOLLOBOT_BUILD_SHA=${APOLLOBOT_RELEASE_SHA}

LABEL org.opencontainers.image.revision=${APOLLOBOT_RELEASE_SHA}

RUN groupadd --gid 10001 apollobot \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin apollobot \
    && mkdir -p /var/lib/apollobot/output \
    && chown -R apollobot:apollobot /var/lib/apollobot

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

USER apollobot:apollobot
EXPOSE 8765

ENTRYPOINT ["apollobot-api"]
